# ---------- App ----------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Security ----------
JWT_SECRET=change-me-to-a-long-random-string
AUTH_ENABLED=false

# ---------- Storage ----------
# dev: sqlite+aiosqlite:///./data/bhati.db   prod: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/bhati.db
REDIS_URL=
WORKSPACE_DIR=./workspaces

# ---------- Model providers (at least one) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Default models ----------
DEFAULT_MODEL=anthropic/claude-sonnet-4
FAST_MODEL=openai/gpt-4o-mini
REASONING_MODEL=openai/o3-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------- Agent limits ----------
MAX_STEPS=40
MAX_PARALLEL_AGENTS=4
STEP_TIMEOUT_SECONDS=180

# ---------- Sandbox ----------
SANDBOX_MODE=local        # local | docker
SANDBOX_IMAGE=bhati/sandbox:latest
SANDBOX_TIMEOUT=120

# ---------- Integrations ----------
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TAVILY_API_KEY=
