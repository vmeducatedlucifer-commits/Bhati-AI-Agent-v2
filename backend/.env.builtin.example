# ---------------------------------------------------------------------------
# Built-in keyless AI model (Gemini web tunnel)
# Ported from Bhati-Ai-Agent v1. Everything here is OPTIONAL - the built-in
# model works with zero API keys. See docs/BUILTIN_MODEL.md
# ---------------------------------------------------------------------------

# Master switch (0 disables the keyless provider)
BUILTIN_MODEL_ENABLED=1

# Make the built-in model the default everywhere (no keys needed at all)
DEFAULT_MODEL=builtin/gemini-2.0-flash
FAST_MODEL=builtin/gemini-2.0-flash
REASONING_MODEL=builtin/gemini-1.5-pro
BUILTIN_DEFAULT_MODEL=gemini-2.0-flash

# Optional: official Google keys (comma separated) - tried before the tunnel
GEMINI_API_KEY=

# Optional: browser cookies for higher limits (multiple separated by |||)
GEMINI_COOKIE=
GEMINI_SAPISID=
GEMINI_AT=

# Tunnel tuning
STREAM_BL=
SESSION_POOL_SIZE=5
ROTATE_SESSION=1
MAX_REQUESTS_PER_SESSION=15
SESSION_COOLDOWN_SECONDS=60
SESSION_TTL=1800
MAX_RETRIES=3
REQUEST_TIMEOUT=180
BROWSER_IMPERSONATE=chrome124
BUILTIN_PREWARM_SESSIONS=1
# UPSTREAM_PROXY=http://user:pass@host:port
