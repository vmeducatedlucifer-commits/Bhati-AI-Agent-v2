# Swarm + custom model settings (append to backend/.env)

# ---- Swarm ----------------------------------------------------------------
SWARM_ENABLED=true
SWARM_MAX_AGENTS=1200          # hard ceiling per run
SWARM_DEFAULT_AGENTS=12        # used when the caller omits size
SWARM_LLM_CONCURRENCY=24       # in-flight model calls (keep <= provider rate limit)
SWARM_AGENT_MAX_STEPS=15       # per-worker step cap inside a swarm
SWARM_MESSAGE_HISTORY=20000    # A2A messages kept per session for the dashboard
SWARM_DEBATE_ROUNDS=1

# Render free tier suggestion:
# SWARM_MAX_AGENTS=50
# SWARM_LLM_CONCURRENCY=4

# ---- Custom models --------------------------------------------------------
CUSTOM_MODELS_FILE=./data/custom_models.json

# Single OpenAI-compatible endpoint (vLLM, LM Studio, Together, Azure, proxy...)
# CUSTOM_OPENAI_BASE_URL=http://localhost:8001/v1
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_MODEL=Qwen2.5-72B-Instruct

# Single Anthropic-compatible gateway (LiteLLM, Bedrock proxy, custom relay)
# CUSTOM_ANTHROPIC_BASE_URL=https://my-gateway.example.com
# CUSTOM_ANTHROPIC_API_KEY=
# CUSTOM_ANTHROPIC_MODEL=claude-sonnet-4

# Make a custom model the global default:
# DEFAULT_MODEL=custom:my-vllm
